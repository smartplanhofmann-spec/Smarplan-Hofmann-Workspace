+            400,
+            'Rückgabe benötigt die ursprüngliche Entnahme',
+          );
+        }
+        return {'id': '99999999999999999999999999999999', ...body};
+      }
+      return {
+        'items': [
+          {
+            'id': issue,
+            'kind': 'issue',
