/* Original-backed same-year historical journal; never a new cash/VAT claim. */
import {oiSame,oiClone,oiHash,oiDay,oiLine,oiIdentity,OI_CATEGORIES,oiCents,oiMoney,oiOriginal,oiState} from './accounting-open-items-contract.js';
export const YV_PATH='/accounting/year-values',YV_RULE='de_euer_same_year_carryover_v1',YV_MAX=5*1024*1024;
export const YV_INPUT=['expected_revision','state_hash','entity_key','profile_ref','operation','payload','reason'];
export const yvSame=oiSame,yvClone=oiClone,yvHash=oiHash,yvDay=oiDay,yvLine=oiLine;
export const yvFail=(message,status=409)=>Object.assign(new Error(message),{status});
const need=(ok,message='Der ursprüngliche Jahresvortrag ist nicht eindeutig gebunden.')=>{if(!ok)throw yvFail(message);};
const obj=v=>v&&typeof v==='object'&&!Array.isArray(v),id=v=>{need(typeof v==='string'&&/^[a-f0-9]{32}$/.test(v));return v;},hash=v=>{need(typeof v==='string'&&/^[a-f0-9]{64}$/.test(v));return v;},integer=(v,min=0)=>{need(Number.isSafeInteger(v)&&v>=min&&v<=2147483646);return v;};
const shape=(v,keys)=>need(obj(v)&&Object.keys(v).length===keys.length&&keys.every(k=>Object.hasOwn(v,k)));
const flags=v=>need(v?.schema_version===1&&v.rule_version===YV_RULE&&v.cash_flow_created===false&&v.new_input_vat_claim_created===false&&v.timezone==='Europe/Berlin');
const input=v=>Object.fromEntries(YV_INPUT.map(k=>[k,v[k]]));
export function yvYear(v){need(typeof v==='string'&&/^20\d\d$/.test(v),'Das unveränderliche Startjahr ausdrücklich angeben.');return v;}
export function yvCents(v){need(typeof v==='string'&&/^-?(?:0|[1-9][0-9]{0,10})\.\d{2}$/.test(v)&&v!=='-0.00','Ursprüngliche vorzeichenbehaftete Centwerte ohne Rundung erforderlich.');return v.startsWith('-')?-oiCents(v.slice(1)):oiCents(v);}
export function yvAmount(v){return(v<0n?'-':'')+(v<0n?-v:v)/100n+'.'+String((v<0n?-v:v)%100n).padStart(2,'0');}
export function yvMoney(v){need(typeof v==='string');const negative=v.trim().startsWith('-'),amount=oiMoney(negative?v.trim().slice(1):v);return negative&&amount!=='0.00'?'-'+amount:amount;}
const account=v=>{need(typeof v==='string'&&/^\d{4}$/.test(v),'Ursprüngliches SKR04-Konto ausdrücklich prüfen.');return v;};
const ref=v=>{shape(v,['id','revision','content_hash']);id(v.id);integer(v.revision,1);hash(v.content_hash);return v;};
const eventRef=v=>({id:v.id,revision:v.revision,content_hash:v.content_hash});
export async function yvProfile(value,reference,{configured=true}={}){need(obj(value)&&obj(value.profile));shape(reference,['id','revision','entry_sha256']);need(value.id===id(reference.id)&&value.revision===integer(reference.revision,1)&&await oiHash(value)===hash(reference.entry_sha256),'Der Jahresvortrag gehört nicht zum ursprünglichen Buchführungsprofil.');const p=value.profile;if(!configured)return p;need(p.legal_form==='sole_proprietorship'&&p.accounting_method==='euer'&&p.vat_regime==='regular'&&p.vat_timing==='cash');oiDay(p.bookkeeping_start);oiDay(p.vat_effective_from);return p;}
export function yvOriginal(value,year=null){if(value?.path?.startsWith('/accounting/open-items/')){need(year===null);return oiOriginal(value,value.entity_key);}need(obj(value)&&value.path===YV_PATH+'/originals/'+id(value.id)&&yvYear(value.entity_key)&&(!year||value.entity_key===year)&&['application/pdf','image/png','image/jpeg'].includes(value.media_type)&&integer(value.size,1)<=YV_MAX);id(value.created_by);hash(value.sha256);oiLine(value.filename,'Originaldateiname');need(!/[\\/]/.test(value.filename)&&typeof value.created_at==='string');return value;}
const proof=(p,originals,year=null)=>{shape(p,['original_id','sha256']);id(p.original_id);hash(p.sha256);const found=originals.find(o=>o.id===p.original_id&&o.sha256===p.sha256);need(found,'Ein unverändertes gebundenes Original fehlt.');return yvOriginal(found,year);};
function coverage(value,opening){shape(value,['from','through']);oiDay(value.from);oiDay(value.through);oiDay(opening);need(value.from>=opening.slice(0,4)+'-01-01'&&value.from<=value.through&&value.through<opening,'Der belegte frühere Zeitraum passt nicht zum ursprünglichen Softwarebeginn.');return value;}
function controls(values){need(Array.isArray(values)&&values.length<=1000);const seen=new Set();for(const v of values){shape(v,['ledger','category','account','amount']);need(['euer','vat'].includes(v.ledger));oiLine(v.category);account(v.account);yvCents(v.amount);const key=JSON.stringify([v.ledger,v.category,v.account]);need(!seen.has(key),'Eine ursprüngliche Kontrollsumme darf nur einmal vorkommen.');seen.add(key);}return [...values].sort((a,b)=>JSON.stringify([a.ledger,a.category,a.account]).localeCompare(JSON.stringify([b.ledger,b.category,b.account]),'en'));}
function details(value,year,opening,period,declared=null){need(obj(value)&&value.schema_version===1&&value.rule_version===YV_RULE&&value.year===Number(year)&&value.opening_date===opening&&oiSame(value.coverage,period)&&value.cash_flow_created===false&&value.new_input_vat_claim_created===false&&value.original_periods_preserved===true);coverage(period,opening);const last=new Date(Date.parse(opening+'T00:00:00Z')-86400000).toISOString().slice(0,10);need(value.complete_prior_period===(period.from===year+'-01-01'&&period.through===last),'Ein Teilzeitraum darf keine vollständige Deckung vortäuschen.');need(Array.isArray(value.historical_postings)&&Array.isArray(value.copied_rows)&&Array.isArray(value.economic_keys));const groups=new Map(),keys=new Set();for(const p of value.historical_postings){shape(p,['ledger','category','account','amount','date','economic_key','original_entry_key','source_ref']);need(['euer','vat'].includes(p.ledger));oiLine(p.category);account(p.account);const amount=yvCents(p.amount);oiDay(p.date);need(p.date>=period.from&&p.date<=period.through);hash(p.economic_key);hash(p.source_ref);oiLine(p.original_entry_key,'Ursprüngliche Buchungsidentität');keys.add(p.economic_key);const group=JSON.stringify([p.ledger,p.category,p.account]);groups.set(group,(groups.get(group)||0n)+amount);}const grouped=[...groups].map(([key,sum])=>{const [ledger,category,account]=JSON.parse(key);return{ledger,category,account,amount:yvAmount(sum)};});need(oiSame(controls(value.controls),controls(grouped))&&(!declared||oiSame(controls(declared),controls(grouped))),'Die historischen Zeilen stimmen nicht mit den ausdrücklich belegten Kontrollsummen überein.');need(oiSame([...keys].sort(),value.economic_keys)&&new Set(value.copied_rows.map(v=>v.economic_key)).size===value.copied_rows.length&&oiSame(value.copied_rows.map(v=>v.economic_key).sort(),value.economic_keys));for(const p of value.copied_rows){hash(p.economic_key);hash(p.source_ref);oiDay(p.date);oiLine(p.original_entry_key);need(['cash_history','already_exercised_input_vat'].includes(p.kind)&&p.date>=period.from&&p.date<=period.through);if(p.kind==='cash_history')need(oiCents(p.net)+oiCents(p.tax)===oiCents(p.gross));else{oiCents(p.amount);oiDay(p.deducted_on);need(/^20\d\d-\d\d$/.test(p.declared_period)&&p.deducted_on>=p.date&&p.deducted_on<opening);}need(value.historical_postings.some(v=>v.economic_key===p.economic_key&&v.date===p.date&&v.original_entry_key===p.original_entry_key&&v.source_ref===p.source_ref));}copiedPostings(value);return value;}
// Independently bind the copied journal to the unchanged resolved original history.
async function originalRows(sources,period){const postings=[],copied=[];for(const s of sources){const r=s.record,original=hash(r.invoice_proof.sha256),inside=day=>day>=period.from&&day<=period.through;
 for(const [i,paid]of r.prior_payments.entries()){if(!inside(paid.date))continue;const net=oiCents(paid.net),tax=oiCents(paid.tax);need(net+tax===oiCents(paid.gross));const economic_key=await oiHash(['cash',original,paid.date,oiIdentity(paid.reference)]),key=s.cash_entry_keys[i],incoming=r.direction==='receivable';need(incoming||r.direction==='payable');const sign=incoming?1n:-1n,base={date:paid.date,economic_key,original_entry_key:key,source_ref:s.source_ref};postings.push({ledger:'euer',category:incoming?'sales':r.category,account:s.accounts.net,amount:yvAmount(sign*net),...base},{ledger:'euer',category:incoming?'vat_collected':'paid_input_vat',account:s.accounts.tax,amount:yvAmount(sign*tax),...base});if(incoming)postings.push({ledger:'vat',category:'output_vat',account:s.accounts.tax,amount:yvAmount(tax),...base});copied.push({kind:'cash_history',...base,gross:paid.gross,net:paid.net,tax:paid.tax});}
 const vat=r.prior_input_vat;if(vat&&inside(vat.entitlement_date)){const economic_key=await oiHash(['input_vat',original]),base={date:vat.entitlement_date,economic_key,original_entry_key:s.vat_entry_key,source_ref:s.source_ref};postings.push({ledger:'vat',category:'input_vat',account:s.accounts.input_vat,amount:yvAmount(-oiCents(vat.amount)),...base});copied.push({kind:'already_exercised_input_vat',...base,amount:vat.amount,deducted_on:vat.deducted_on,declared_period:vat.declared_period});}}
 return{postings,copied};}
function copiedPostings(value){for(const row of value.copied_rows){const actual=value.historical_postings.filter(p=>p.economic_key===row.economic_key),part=(index,ledger,category,amount)=>({ledger,category,account:actual[index]?.account,amount:yvAmount(amount),date:row.date,economic_key:row.economic_key,original_entry_key:row.original_entry_key,source_ref:row.source_ref});let expected;
 if(row.kind==='already_exercised_input_vat')expected=[part(0,'vat','input_vat',-oiCents(row.amount))];
 else if(actual.length===3)expected=[part(0,'euer','sales',oiCents(row.net)),part(1,'euer','vat_collected',oiCents(row.tax)),part(2,'vat','output_vat',oiCents(row.tax))];
 else {need(actual.length===2&&Object.hasOwn(OI_CATEGORIES,actual[0].category)&&actual[0].category!=='sales');expected=[part(0,'euer',actual[0].category,-oiCents(row.net)),part(1,'euer','paid_input_vat',-oiCents(row.tax))];}
 need(oiSame(actual,expected),'Die kopierten ursprünglichen Cents widersprechen den zugehörigen Journalzeilen.');}}
export async function yvPreview(value,body,{openingItems=null}={}){flags(value);need(oiSame(input(value),input(body))&&value.operation==='year_values','Die Vorschau bestätigt nicht genau die ursprünglichen Jahresangaben.');integer(value.expected_revision);hash(value.state_hash);const year=yvYear(value.entity_key),p=await yvProfile(value.profile,value.profile_ref);need(p.bookkeeping_start.slice(0,4)===year);oiLine(value.reason,'Prüfgrund',1000);if(value.previous_ref!==null)ref(value.previous_ref);const v=value.payload;shape(v,['status','coverage','sources','controls','ledger_proof','attestations']);need(['active','void'].includes(v.status));coverage(v.coverage,p.bookkeeping_start);shape(v.attestations,['continuous_method','original_journal_complete','no_unsupported_values']);need(Object.values(v.attestations).every(x=>x===true));need(Array.isArray(v.sources)&&v.sources.length<=1000&&Array.isArray(value.resolved_sources)&&value.resolved_sources.length===v.sources.length&&Array.isArray(value.proofs));const journal=proof(v.ledger_proof,value.proofs,year);need(value.proofs[0]?.id===journal.id&&value.proofs.slice(1).every(o=>o.sha256!==journal.sha256),'Ein eigenständiger Zeitraumjournalnachweis ist erforderlich.');for(const o of value.proofs)yvOriginal(o);for(let i=0;i<v.sources.length;i++){const s=v.sources[i],resolved=value.resolved_sources[i];need(obj(s)&&obj(resolved)&&resolved.kind===s.kind&&oiSame(s.accounts,resolved.accounts)&&oiSame(s.cash_entry_keys,resolved.cash_entry_keys)&&s.vat_entry_key===resolved.vat_entry_key);shape(s.accounts,['net','tax','input_vat']);Object.values(s.accounts).forEach(account);need(Array.isArray(s.cash_entry_keys)&&s.cash_entry_keys.length===resolved.record?.prior_payments?.length);s.cash_entry_keys.forEach(k=>oiLine(k,'Ursprüngliche Zahlungsbuchung'));if(s.kind==='opening_item'){shape(s,['kind','entry_id','entry_hash','accounts','cash_entry_keys','vat_entry_key']);id(s.entry_id);need(resolved.source_ref===hash(s.entry_hash));if(openingItems){const original=openingItems.find(e=>e.id===s.entry_id&&e.content_hash===s.entry_hash);need(original&&oiSame(original.payload,resolved.record),'Die ausgewählte kanonische Altpostenfassung wurde verändert.');}}else{need(s.kind==='closed_trade');shape(s,['kind','record','accounts','cash_entry_keys','vat_entry_key']);need(oiSame(s.record,resolved.record),'Der vollständig bezahlte ursprüngliche Beleg wurde ersetzt.');const r=s.record,originals=[r.invoice_proof,r.cutover_proof,...r.prior_payments.map(p=>p.proof),...(r.prior_input_vat?[r.prior_input_vat.proof]:[])].map(v=>proof(v,value.proofs,year));need(resolved.source_ref===await oiHash({record:r,proofs:originals}));need(r.prior_payments.reduce((sum,p)=>sum+oiCents(p.gross),0n)===oiCents(r.gross),'Ein externer erledigter Beleg muss vor Beginn vollständig bezahlt sein.');}hash(resolved.source_ref);if(resolved.record.prior_input_vat)oiLine(s.vat_entry_key,'Ursprüngliche Vorsteuerbuchung');else need(s.vat_entry_key===null);}
 details(value.details,year,p.bookkeeping_start,v.coverage,v.controls);const original=await originalRows(value.resolved_sources,v.coverage);need(oiSame(value.details.historical_postings,original.postings)&&oiSame(value.details.copied_rows,original.copied),'Die kopierten ursprünglichen Tage und Cents stimmen nicht mit den unveränderten Originalquellen überein.');const {preview_hash,...raw}=value;need(await oiHash(raw)===hash(preview_hash),'Die Jahresvorschau besteht ihre Originalprüfsumme nicht.');return value;}
export async function yvRecord(value){need(obj(value));const{id:entryId,sequence,revision,previous_hash,created_by,created_at,content_hash,...preview}=value;id(entryId);id(created_by);integer(sequence,1);integer(revision,1);need(typeof created_at==='string');if(previous_hash!==null)hash(previous_hash);const raw={...preview,id:entryId,sequence,revision,previous_hash,created_by,created_at};need(await oiHash(raw)===hash(content_hash));await yvPreview(preview,input(preview));need(sequence===value.expected_revision+1&&revision===(value.previous_ref?.revision||0)+1);return value;}
export async function yvState(value){flags(value);integer(value.revision);hash(value.state_hash);need(Array.isArray(value.items)&&Array.isArray(value.originals)&&typeof value.can_prepare==='boolean'&&value.max_original_bytes===YV_MAX);if(value.profile===null)need(value.profile_ref===null&&!value.can_prepare);else await yvProfile(value.profile,value.profile_ref,{configured:false});const originals=new Map();for(const o of value.originals){yvOriginal(o,o.entity_key);need(!originals.has(o.id));originals.set(o.id,o);}const seen=new Set();for(const e of value.items){await yvRecord(e);need(!seen.has(e.entity_key)&&e.sequence<=value.revision);seen.add(e.entity_key);for(const o of e.proofs.filter(v=>v.path.startsWith(YV_PATH+'/')))need(oiSame(o,originals.get(o.id)));}const head=value.items.find(e=>e.sequence===value.revision)?.content_hash??null;need((value.revision===0)===(value.items.length===0)&&(value.revision===0||head)&&await oiHash({schema_version:1,revision:value.revision,head})===value.state_hash);return value;}
export async function yvHistory(value,year){need(value?.schema_version===1&&value.entity_key===year&&Array.isArray(value.items));let old=null;for(const e of value.items){await yvRecord(e);need(e.entity_key===year&&e.revision===(old?.revision||0)+1&&oiSame(e.previous_ref,old?eventRef(old):null));old=e;}return value;}
export function yvReceipt(body,preview,state){const b=oiClone(body),p=oiClone(preview),old=state.items.find(e=>e.entity_key===b.entity_key),head=state.items.find(e=>e.sequence===state.revision)?.content_hash??null;return async raw=>{const value=await yvRecord(raw),{id,sequence,revision,previous_hash,created_by,created_at,content_hash,...actual}=value;need(b.confirmation===true&&oiSame(actual,p)&&oiSame(input(value),input(b))&&value.preview_hash===b.preview_hash&&value.previous_hash===head&&oiSame(value.previous_ref,old?eventRef(old):null),'Die Quittung bestätigt nicht den ursprünglichen Jahresvortragsauftrag.');return value;};}
export function yvUploadReceipt(body,file){const b=oiClone(body),f=oiClone(file);return raw=>{const value=yvOriginal(raw,b.entity_key);need(value.filename===b.filename&&value.media_type===b.media_type&&value.sha256===f.sha256&&value.size===f.size,'Die Originalannahme gehört nicht zur gewählten Jahresdatei.');return value;};}
export function yvSource(value){need(value?.kind==='opening_year_values'&&value.schema_version===1&&value.rule_version===YV_RULE&&['active','void'].includes(value.status));yvYear(value.id);id(value.entry_id);hash(value.entry_hash);hash(value.source_hash);integer(value.revision,1);oiDay(value.date);need(value.date.slice(0,4)===value.id&&value.source_path===YV_PATH+'/years/'+value.id+'?revision='+value.revision&&Array.isArray(value.cash_movements)&&value.cash_movements.length===0);shape(value.profile_ref,['id','revision','entry_sha256']);id(value.profile_ref.id);integer(value.profile_ref.revision,1);hash(value.profile_ref.entry_sha256);shape(value.attestations,['continuous_method','original_journal_complete','no_unsupported_values']);need(Object.values(value.attestations).every(v=>v===true)&&Array.isArray(value.proofs));value.proofs.forEach(v=>yvOriginal(v));details(value.details,value.id,value.date,value.coverage);return value;}
export async function yvVerifiedSource(value){yvSource(value);const {source_hash,...raw}=value;need(await oiHash(raw)===source_hash,'Die historische Jahresquelle besteht ihre Originalprüfsumme nicht.');return value;}
export function yvEuerEffect(effect,source,payload){yvSource(source);need(source.status==='active'&&effect?.operation==='opening_year_values'&&oiSame(effect.source,source)&&oiSame(effect.payload,payload)&&payload.year===source.id&&payload.revision===source.revision&&payload.source_hash===source.source_hash);const target='opening_year_values:'+source.id,postings=source.details.historical_postings.map(p=>({ledger:p.ledger,category:p.category,amount:p.amount,date:p.date,account:p.account,source_key:target+':'+p.economic_key}));need(effect.target===target&&oiSame(effect.postings,postings)&&oiSame(effect.details,{date:source.date,coverage:source.coverage,cash_flow_created:false,new_input_vat_claim_created:false,original_periods_preserved:true}),'Die EÜR-Vorschau verändert alte Originaltage/-anteile oder erzeugt eine neue Wirkung.');return effect;}
export function yvRights(caps){const p=new Set(caps?.permissions||[]),read=!!(caps?.features?.includes('accounting_year_values')&&caps.capabilities?.includes('business_accounting_year_openings')&&['accounting.read','finance.read'].every(k=>p.has(k))),approve=read&&caps.readonly===false&&['accounting.admin','accounting.prepare','finance.write'].every(k=>p.has(k));return{read,approve,write:approve&&caps.organization?.modules?.finance?.enabled!==false};}
export async function yvAuthorize(api,{write=false,replay=false}={}){if(write&&globalThis.navigator?.onLine===false)throw yvFail('Jahresvorträge benötigen eine aktuelle Serververbindung.',423);let caps=await api.get('/business/capabilities'),rights=yvRights(caps);check();const state=await yvState(await api.get('/business'+YV_PATH));caps=await api.get('/business/capabilities');rights=yvRights(caps);check();if(write&&(!rights.write||!replay&&!state.can_prepare))throw yvFail('Jahresvorträge sind im aktuellen Finanzzustand gesperrt.',423);return{caps,rights,state};function check(){if(!rights.read||write&&!rights.approve)throw yvFail('Aktuelle globale Buchführungs- und Finanzrechte fehlen.',403);}}
export async function yvPendingAuthorize(api,{key,path}){const base='/business'+YV_PATH;need([base+'/originals',base+'/confirm'].includes(path));const b=api.pendingCommandValues(key,path),kind=path.endsWith('/originals')?'original':'confirm';need(b&&key==='accounting-year-values-'+kind+'-'+yvYear(b.entity_key));await yvAuthorize(api,{write:true,replay:true});return true;}
export function yvInput(state,year,payload,reason){need(state.can_prepare&&state.profile_ref,'Aktuelles bestätigtes Profil und Finanzfreigabe erforderlich.');return{expected_revision:state.revision,state_hash:state.state_hash,entity_key:yvYear(year),profile_ref:oiClone(state.profile_ref),operation:'year_values',payload:oiClone(payload),reason:oiLine(reason,'Prüfgrund',1000)};}
export const yvOpeningItems=oiState;

export function yvConfigured(state){const p=state?.profile?.profile;return !!(p&&p.legal_form==='sole_proprietorship'&&p.accounting_method==='euer'&&p.vat_regime==='regular'&&p.vat_timing==='cash'&&/^20\d\d-\d\d-\d\d$/.test(p.bookkeeping_start||'')&&/^20\d\d-\d\d-\d\d$/.test(p.vat_effective_from||''));}
