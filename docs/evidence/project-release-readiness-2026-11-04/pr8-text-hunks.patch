+    final uri = Uri.parse(path), route = Uri.parse(path).path;
+    calls.add((
+      path: path,
+      body: body == null
+          ? null
+          : Map<String, dynamic>.from(jsonDecode(jsonEncode(body))),
+    ));
+    if (route == '/api/business/capabilities') {
+      return {
