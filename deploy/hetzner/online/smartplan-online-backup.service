[Unit]
Description=Consistent PostgreSQL backup of Smartplan online pilot
After=postgresql.service

[Service]
Type=oneshot
User=smartplan-online
Group=smartplan-online
WorkingDirectory=/opt/smartplan-online/app/backend
EnvironmentFile=/etc/smartplan-online/service.env
StateDirectory=smartplan-online
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/env /opt/smartplan-online/venv/bin/python -m online.backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
TimeoutStartSec=330
TasksMax=32
