[Unit]
Description=Smartplan shared online pilot API (PostgreSQL and MFA)
Wants=network-online.target
After=network-online.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=smartplan-online
Group=smartplan-online
WorkingDirectory=/opt/smartplan-online/app/backend
EnvironmentFile=/etc/smartplan-online/service.env
StateDirectory=smartplan-online
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/env /opt/smartplan-online/venv/bin/gunicorn online.web:create_app() --bind 127.0.0.1:8766 --worker-class gthread --workers 2 --threads 4 --worker-connections 32 --timeout 30 --graceful-timeout 15 --max-requests 1000 --max-requests-jitter 100 --limit-request-line 4094 --limit-request-fields 50 --limit-request-field_size 8190 --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
TasksMax=128

[Install]
WantedBy=multi-user.target
