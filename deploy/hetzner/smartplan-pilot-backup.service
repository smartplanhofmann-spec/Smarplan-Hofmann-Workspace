[Unit]
Description=Consistent local backup of the Smartplan private pilot
After=smartplan-pilot.service

[Service]
Type=oneshot
User=smartplan-pilot
Group=smartplan-pilot
WorkingDirectory=/opt/smartplan-test
Environment=OFFICE_DATA_DIR=/var/lib/smartplan-pilot
StateDirectory=smartplan-pilot
StateDirectoryMode=0700
UMask=0077
ExecStart=/bin/bash /opt/smartplan-test/deploy/hetzner/run-pilot.sh backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
TasksMax=16
