+            else:
+                original_id=uuid.uuid4().hex
+                self.db.execute(f'INSERT INTO {TABLES[0]}(id,entity_key,filename,media_type,size,sha256,original,created_by,created_at) VALUES(?,?,?,?,?,?,?,?,?)',
