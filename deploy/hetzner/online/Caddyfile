{
	admin unix//run/smartplan-https/admin.sock
	servers {
		protocols h1 h2
	}
}

office.smartplan-hofmann.de {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Cache-Control no-store
		Strict-Transport-Security "max-age=31536000"
	}
	@restricted not path / /office /office/*
	header @restricted >Content-Security-Policy "default-src 'none'; style-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
	@browser path / /office /office/*
	header @browser >Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"

	@online path /api/v1/* /health /ready / /office /office/*
	handle @online {
		@business path /api/v1/business /api/v1/business/*
		handle @business {
			reverse_proxy 127.0.0.1:8766 {
				lb_try_duration 3s
				transport http {
					dial_timeout 3s
					response_header_timeout 240s
				}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:8766 {
				lb_try_duration 3s
				transport http {
					dial_timeout 3s
					response_header_timeout 25s
				}
			}
		}
	}

	@application path /api /api/* /auth /auth/* /oauth /oauth/*
	handle @application {
		header Content-Type application/json
		respond `{"status":"setup"}` 503
	}

	@page path / /index.html /style.css
	handle @page {
		root * /usr/share/smartplan-setup
		file_server
	}

	handle {
		respond "Nicht gefunden" 404
	}
}
